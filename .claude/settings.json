{
  "hooks": {
    "SubagentStop": [
      {
        "matcher": "code-reviewer",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/review-gate.mjs\" mark",
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/review-gate.mjs\" stop",
            "timeout": 30,
            "statusMessage": "코드 리뷰 여부 확인 중"
          }
        ]
      }
    ]
  }
}
